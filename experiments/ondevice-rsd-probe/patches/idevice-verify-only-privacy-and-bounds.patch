index 3705645..a10766b 100644
--- a/idevice/src/services/dvt/xctest/mod.rs
+++ b/idevice/src/services/dvt/xctest/mod.rs
@@ -1953,0 +1954,193 @@ fn wda_port_from_runner_environment(
+const FIXED_ONDEVICE_WDA_BUNDLE_ID: &str = "com.ios-use.wda.00008101-00064d1a3a68001e";
+const FIXED_ONDEVICE_IOS_MAJOR_VERSION: u8 = 26;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[repr(u32)]
+pub enum FixedOnDeviceWdaStage {
+    InstallationProxy = 1,
+    RunnerLookup = 2,
+    DtServiceHub = 3,
+    TestManagerControl = 4,
+    TestManagerMain = 5,
+    ProxyChannels = 6,
+    SessionInitialization = 7,
+    RunnerLaunch = 8,
+    RunnerAuthorization = 9,
+    DriverChannel = 10,
+    StartTestPlan = 11,
+    ControllerActive = 12,
+}
+
+fn fixed_wda_stage(progress: &std::sync::atomic::AtomicU32, stage: FixedOnDeviceWdaStage) {
+    progress.store(stage as u32, std::sync::atomic::Ordering::SeqCst);
+}
+
+/// Retains the local XCTest controller task after fixed WDA bootstrap.
+/// Dropping this handle aborts the controller fail-closed.
+#[derive(Debug)]
+pub struct FixedOnDeviceWdaController {
+    task: tokio::task::JoinHandle<Result<(), IdeviceError>>,
+}
+
+impl FixedOnDeviceWdaController {
+    pub fn is_running(&self) -> bool {
+        !self.task.is_finished()
+    }
+
+    pub fn abort(&self) {
+        self.task.abort();
+    }
+}
+
+impl Drop for FixedOnDeviceWdaController {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+struct FixedOnDeviceXCTestListener;
+
+impl XCUITestListener for FixedOnDeviceXCTestListener {}
+
+/// Starts the one compile-time WDA runner over an already-established
+/// userspace RSD adapter. No provider, destination, bundle, environment,
+/// argument, selector, or payload is accepted from the caller.
+pub async fn start_fixed_ondevice_wda_controller(
+    mut handle: crate::tcp::handle::AdapterHandle,
+    mut handshake: RsdHandshake,
+    progress: &std::sync::atomic::AtomicU32,
+) -> Result<FixedOnDeviceWdaController, IdeviceError> {
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::InstallationProxy);
+    let mut installation_proxy = handshake
+        .connect::<InstallationProxyClient>(&mut handle)
+        .await?;
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::RunnerLookup);
+    let mut cfg = TestConfig::from_installation_proxy(
+        &mut installation_proxy,
+        FIXED_ONDEVICE_WDA_BUNDLE_ID,
+        None,
+    )
+    .await?;
+    drop(installation_proxy);
+
+    cfg.runner_env = Some(crate::plist!(dict {
+        "USE_IP": "127.0.0.1",
+        "USE_PORT": "8100",
+        "MJPEG_SERVER_PORT": "9100",
+    }));
+
+    let session_id = uuid::Uuid::new_v4();
+    let xctest_path = format!(
+        "/tmp/{}.xctestconfiguration",
+        session_id.to_string().to_uppercase()
+    );
+    let xctest_config =
+        cfg.build_xctest_configuration(session_id, FIXED_ONDEVICE_IOS_MAJOR_VERSION)?;
+
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::DtServiceHub);
+    let dvt = rsd_connect(
+        &mut handle,
+        &handshake,
+        "com.apple.instruments.dtservicehub",
+        "jarvis-fixed-wda-dtservicehub",
+        true,
+    )
+    .await?;
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::TestManagerControl);
+    let ctrl = rsd_connect(
+        &mut handle,
+        &handshake,
+        TESTMANAGERD_RSD_SERVICE,
+        "jarvis-fixed-wda-testmanager-ctrl",
+        false,
+    )
+    .await?;
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::TestManagerMain);
+    let main = rsd_connect(
+        &mut handle,
+        &handshake,
+        TESTMANAGERD_RSD_SERVICE,
+        "jarvis-fixed-wda-testmanager-main",
+        false,
+    )
+    .await?;
+    let mut conns = TestManagerConnections {
+        ctrl,
+        main,
+        dvt,
+        rsd_handles: vec![handle],
+    };
+
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::ProxyChannels);
+    let mut ctrl_proxy =
+        TestManagerProxy::open(&mut conns.ctrl, FIXED_ONDEVICE_IOS_MAJOR_VERSION).await?;
+    let mut main_proxy =
+        TestManagerProxy::open(&mut conns.main, FIXED_ONDEVICE_IOS_MAJOR_VERSION).await?;
+    let mut process_control = XCTestProcessControlChannel::open(&mut conns.dvt).await?;
+
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::SessionInitialization);
+    initialize_testmanager_sessions(&mut ctrl_proxy, &mut main_proxy, &xctest_config).await?;
+    register_early_driver_channel_handler(&mut conns.main, &xctest_config).await;
+    initialize_testmanager_daemon_sessions(
+        &mut ctrl_proxy,
+        &mut main_proxy,
+        FIXED_ONDEVICE_IOS_MAJOR_VERSION,
+        &session_id,
+        &xctest_config,
+    )
+    .await?;
+
+    let (launch_args, launch_env, launch_options) = build_launch_env(
+        FIXED_ONDEVICE_IOS_MAJOR_VERSION,
+        &session_id,
+        &cfg.runner_app_path,
+        &cfg.runner_app_container,
+        cfg.config_name(),
+        &xctest_path,
+        cfg.runner_env.as_ref(),
+        None,
+    );
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::RunnerLaunch);
+    let pid = process_control
+        .launch_suspended_process(
+            FIXED_ONDEVICE_WDA_BUNDLE_ID,
+            launch_args,
+            launch_env,
+            launch_options,
+        )
+        .await?;
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::RunnerAuthorization);
+    ctrl_proxy
+        .authorize_test(FIXED_ONDEVICE_IOS_MAJOR_VERSION, pid)
+        .await?;
+    drop(process_control);
+
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::DriverChannel);
+    let mut driver_proxy = DriverProxy::wait(&mut conns.main, 30.0).await?;
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::StartTestPlan);
+    driver_proxy.start_executing_test_plan().await?;
+    driver_proxy.channel.clear_incoming_handler().await;
+    let driver_channel = driver_proxy.channel;
+    let TestManagerConnections {
+        ctrl,
+        mut main,
+        dvt,
+        rsd_handles,
+    } = conns;
+    fixed_wda_stage(progress, FixedOnDeviceWdaStage::ControllerActive);
+    let task = tokio::spawn(async move {
+        let _keep_alive = (ctrl_proxy, main_proxy, ctrl, dvt, rsd_handles);
+        let mut listener = FixedOnDeviceXCTestListener;
+        run_dispatch_loop_until_done_or_disconnect(
+            &mut main,
+            driver_channel,
+            &xctest_config,
+            &mut listener,
+            None,
+        )
+        .await
+    });
+
+    Ok(FixedOnDeviceWdaController { task })
+}
