diff --git a/idevice/src/services/dvt/fixed_channel_probe.rs b/idevice/src/services/dvt/fixed_channel_probe.rs
new file mode 100644
index 0000000..456173f
--- /dev/null
+++ b/idevice/src/services/dvt/fixed_channel_probe.rs
@@ -0,0 +1,277 @@
+//! Fixed DTX probes used by the Jarvis Gate 2–3 experiments.
+//!
+//! Gate 2 stops after three DTX capability handshakes. Gate 3 requests only
+//! two compile-time XCTestManager proxy channels and immediately closes their
+//! transports. Neither path initialises an XCTest session, authorises a runner,
+//! launches a process, or retains a DTX client after returning.
+
+use std::time::Duration;
+
+use plist::{Dictionary, Value};
+
+use crate::services::dvt::remote_server::RemoteServerClient;
+use crate::services::rsd::RsdHandshake;
+use crate::tcp::handle::AdapterHandle;
+use crate::{IdeviceError, ReadWrite};
+
+const DTSERVICEHUB: &str = "com.apple.instruments.dtservicehub";
+const TESTMANAGERD: &str = "com.apple.dt.testmanagerd.remote";
+const XCTEST_MANAGER_PROXY_IDENTIFIER: &str =
+    "dtxproxy:XCTestManager_IDEInterface:XCTestManager_DaemonConnectionInterface";
+const HANDSHAKE_TIMEOUT: Duration = Duration::from_secs(8);
+
+pub const FIXED_DTX_DTSERVICEHUB: u32 = 1 << 0;
+pub const FIXED_DTX_TESTMANAGER_CTRL: u32 = 1 << 1;
+pub const FIXED_DTX_TESTMANAGER_MAIN: u32 = 1 << 2;
+pub const FIXED_PROXY_TESTMANAGER_CTRL: u32 = 1 << 0;
+pub const FIXED_PROXY_TESTMANAGER_MAIN: u32 = 1 << 1;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[repr(u32)]
+pub enum FixedDtxProbeStage {
+    DtServiceHubTcp = 1,
+    DtServiceHubHandshake = 2,
+    TestManagerCtrlTcp = 3,
+    TestManagerCtrlHandshake = 4,
+    TestManagerMainTcp = 5,
+    TestManagerMainHandshake = 6,
+}
+
+#[derive(Debug)]
+pub struct FixedDtxProbeFailure {
+    pub stage: FixedDtxProbeStage,
+    pub error: IdeviceError,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct FixedDtxProbeResult {
+    pub channel_mask: u32,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[repr(u32)]
+pub enum FixedProxyProbeStage {
+    TestManagerCtrlTcp = 1,
+    TestManagerCtrlHandshake = 2,
+    TestManagerMainTcp = 3,
+    TestManagerMainHandshake = 4,
+    TestManagerCtrlProxyChannel = 5,
+    TestManagerMainProxyChannel = 6,
+}
+
+#[derive(Debug)]
+pub struct FixedProxyProbeFailure {
+    pub stage: FixedProxyProbeStage,
+    pub error: IdeviceError,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct FixedProxyProbeResult {
+    pub channel_mask: u32,
+}
+
+fn capabilities(include_process_control_callback: bool) -> Dictionary {
+    let mut capabilities = Dictionary::new();
+    capabilities.insert(
+        "com.apple.private.DTXBlockCompression".into(),
+        Value::Integer(0i64.into()),
+    );
+    capabilities.insert(
+        "com.apple.private.DTXConnection".into(),
+        Value::Integer(1i64.into()),
+    );
+    if include_process_control_callback {
+        capabilities.insert(
+            "com.apple.instruments.client.processcontrol.capability.terminationCallback".into(),
+            Value::Integer(1i64.into()),
+        );
+    }
+    capabilities
+}
+
+#[allow(clippy::too_many_arguments)]
+async fn open_fixed_connection(
+    handle: &mut AdapterHandle,
+    handshake: &RsdHandshake,
+    service_name: &'static str,
+    label: &'static str,
+    include_process_control_callback: bool,
+    tcp_stage: FixedDtxProbeStage,
+    handshake_stage: FixedDtxProbeStage,
+) -> Result<RemoteServerClient<Box<dyn ReadWrite>>, FixedDtxProbeFailure> {
+    let service = handshake
+        .services
+        .get(service_name)
+        .ok_or_else(|| FixedDtxProbeFailure {
+            stage: tcp_stage,
+            error: IdeviceError::ServiceNotFound,
+        })?;
+    let stream = crate::time::timeout(HANDSHAKE_TIMEOUT, handle.connect(service.port))
+        .await
+        .map_err(|_| FixedDtxProbeFailure {
+            stage: tcp_stage,
+            error: IdeviceError::Timeout,
+        })?
+        .map_err(|error| FixedDtxProbeFailure {
+            stage: tcp_stage,
+            error: error.into(),
+        })?;
+    let mut client = RemoteServerClient::with_label(stream, label);
+    client
+        .perform_handshake(
+            Some(capabilities(include_process_control_callback)),
+            HANDSHAKE_TIMEOUT,
+        )
+        .await
+        .map_err(|error| FixedDtxProbeFailure {
+            stage: handshake_stage,
+            error,
+        })?;
+    Ok(client)
+}
+
+/// Opens exactly one dtservicehub DTX transport and two testmanagerd DTX
+/// transports, performs only their fixed capability handshakes, then drops all
+/// three clients before returning.
+pub async fn probe_fixed_testmanager_connections(
+    handle: &mut AdapterHandle,
+    handshake: &RsdHandshake,
+) -> Result<FixedDtxProbeResult, FixedDtxProbeFailure> {
+    let dtservicehub = open_fixed_connection(
+        handle,
+        handshake,
+        DTSERVICEHUB,
+        "jarvis-gate2-dtservicehub",
+        true,
+        FixedDtxProbeStage::DtServiceHubTcp,
+        FixedDtxProbeStage::DtServiceHubHandshake,
+    )
+    .await?;
+    let control = open_fixed_connection(
+        handle,
+        handshake,
+        TESTMANAGERD,
+        "jarvis-gate2-testmanager-ctrl",
+        false,
+        FixedDtxProbeStage::TestManagerCtrlTcp,
+        FixedDtxProbeStage::TestManagerCtrlHandshake,
+    )
+    .await?;
+    let main = open_fixed_connection(
+        handle,
+        handshake,
+        TESTMANAGERD,
+        "jarvis-gate2-testmanager-main",
+        false,
+        FixedDtxProbeStage::TestManagerMainTcp,
+        FixedDtxProbeStage::TestManagerMainHandshake,
+    )
+    .await?;
+
+    // Explicitly close all three transports before crossing the public API.
+    drop((main, control, dtservicehub));
+    Ok(FixedDtxProbeResult {
+        channel_mask: FIXED_DTX_DTSERVICEHUB
+            | FIXED_DTX_TESTMANAGER_CTRL
+            | FIXED_DTX_TESTMANAGER_MAIN,
+    })
+}
+
+async fn open_fixed_proxy_connection(
+    handle: &mut AdapterHandle,
+    handshake: &RsdHandshake,
+    label: &'static str,
+    tcp_stage: FixedProxyProbeStage,
+    handshake_stage: FixedProxyProbeStage,
+) -> Result<RemoteServerClient<Box<dyn ReadWrite>>, FixedProxyProbeFailure> {
+    let service = handshake
+        .services
+        .get(TESTMANAGERD)
+        .ok_or_else(|| FixedProxyProbeFailure {
+            stage: tcp_stage,
+            error: IdeviceError::ServiceNotFound,
+        })?;
+    let stream = crate::time::timeout(HANDSHAKE_TIMEOUT, handle.connect(service.port))
+        .await
+        .map_err(|_| FixedProxyProbeFailure {
+            stage: tcp_stage,
+            error: IdeviceError::Timeout,
+        })?
+        .map_err(|error| FixedProxyProbeFailure {
+            stage: tcp_stage,
+            error: error.into(),
+        })?;
+    let mut client = RemoteServerClient::with_label(stream, label);
+    client
+        .perform_handshake(Some(capabilities(false)), HANDSHAKE_TIMEOUT)
+        .await
+        .map_err(|error| FixedProxyProbeFailure {
+            stage: handshake_stage,
+            error,
+        })?;
+    Ok(client)
+}
+
+/// Opens exactly two testmanagerd transports and one fixed XCTestManager
+/// proxy channel on each. The channel handles and transports are all dropped
+/// before returning. No XCTest session selector or payload is sent.
+pub async fn probe_fixed_xctestmanager_proxy_channels(
+    handle: &mut AdapterHandle,
+    handshake: &RsdHandshake,
+) -> Result<FixedProxyProbeResult, FixedProxyProbeFailure> {
+    let mut control = open_fixed_proxy_connection(
+        handle,
+        handshake,
+        "jarvis-gate3-testmanager-ctrl",
+        FixedProxyProbeStage::TestManagerCtrlTcp,
+        FixedProxyProbeStage::TestManagerCtrlHandshake,
+    )
+    .await?;
+    let mut main = open_fixed_proxy_connection(
+        handle,
+        handshake,
+        "jarvis-gate3-testmanager-main",
+        FixedProxyProbeStage::TestManagerMainTcp,
+        FixedProxyProbeStage::TestManagerMainHandshake,
+    )
+    .await?;
+
+    {
+        let channel = crate::time::timeout(
+            HANDSHAKE_TIMEOUT,
+            control.make_channel(XCTEST_MANAGER_PROXY_IDENTIFIER),
+        )
+        .await
+        .map_err(|_| FixedProxyProbeFailure {
+            stage: FixedProxyProbeStage::TestManagerCtrlProxyChannel,
+            error: IdeviceError::Timeout,
+        })?
+        .map_err(|error| FixedProxyProbeFailure {
+            stage: FixedProxyProbeStage::TestManagerCtrlProxyChannel,
+            error,
+        })?;
+        drop(channel);
+    }
+    {
+        let channel = crate::time::timeout(
+            HANDSHAKE_TIMEOUT,
+            main.make_channel(XCTEST_MANAGER_PROXY_IDENTIFIER),
+        )
+        .await
+        .map_err(|_| FixedProxyProbeFailure {
+            stage: FixedProxyProbeStage::TestManagerMainProxyChannel,
+            error: IdeviceError::Timeout,
+        })?
+        .map_err(|error| FixedProxyProbeFailure {
+            stage: FixedProxyProbeStage::TestManagerMainProxyChannel,
+            error,
+        })?;
+        drop(channel);
+    }
+
+    // Closing each transport also closes its one requested proxy channel.
+    drop((main, control));
+    Ok(FixedProxyProbeResult {
+        channel_mask: FIXED_PROXY_TESTMANAGER_CTRL | FIXED_PROXY_TESTMANAGER_MAIN,
+    })
+}
